{
    "name": "sonicfx",
    "version": "1.0.0",
    "description": "Audio-reactive CSS visual effects for DOM: dynamic gradients, CSS filters, glow borders and overlays driven by music stem energy. Zero dependencies.",
    "main": "src/sonicfx.js",
    "module": "src/sonicfx.js",
    "type": "module",
    "files": [
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "esbuild src/sonicfx.js --bundle --minify --format=esm --outfile=dist/sonicfx.min.js",
        "dev": "esbuild src/sonicfx.js --bundle --format=esm --outfile=dist/sonicfx.js --watch"
    },
    "keywords": [
        "audio",
        "visual-effects",
        "reactive",
        "css-effects",
        "gradients",
        "instrument",
        "sonicmotion",
        "music",
        "animation"
    ],
    "author": "axscq",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.20.0"
    }
}